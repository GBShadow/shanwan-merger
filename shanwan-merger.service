[Unit]
Description=ShanWan Android-mode event merger (event20 + event22 -> unified uinput gamepad)
DefaultDependencies=no
After=systemd-udev-trigger.service usbcore-shanwan-quirk.service
Wants=usbcore-shanwan-quirk.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/gbshadow/projects/shanwan-merger/merger.py
Restart=always
RestartSec=2
TimeoutStopSec=3
KillSignal=SIGTERM

[Install]
WantedBy=default.target